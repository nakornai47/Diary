# ตัวอย่างไฟล์ตั้งค่าสภาพแวดล้อมสำหรับ Diary Sync Server
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง

# API key สำหรับ authenticate client (ต้องยาวอย่างน้อย 8 ตัวอักษร)
SYNC_API_KEY=your-strong-secret-key

# พอร์ตที่ server จะรัน (ค่าเริ่มต้น 3456)
PORT=3456

# โฟลเดอร์เก็บไฟล์ข้อมูล (ค่าเริ่มต้นคือ data/ ในโฟลเดอร์ server)
DATA_DIR=./data

# รายการ origin ที่อนุญาตให้เชื่อมต่อผ่าน CORS
# ใช้ * เพื่ออนุญาตทั้งหมด (เหมาะกับทดสอบ) หรือระบุ origin ของ GitHub Pages
# ALLOWED_ORIGINS=https://yourname.github.io,http://localhost:8081
ALLOWED_ORIGINS=*
